{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu2bs",
  "version": "0.1.0",
  "identifier": "dev.c0okiemf.osu2bs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "osu2bs",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
